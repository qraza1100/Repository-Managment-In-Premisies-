<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QualityAviationHelpdesk</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- NuGet's vulnerability audit hangs on this network; the deploy agent's Security stage checks packages instead -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.10" />
  </ItemGroup>

  <!-- The schema is applied by the app itself (or by a DBA running the same files): db\migrations\*.sql, in name order -->
  <ItemGroup>
    <EmbeddedResource Include="..\db\migrations\*.sql" LogicalName="Schema.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QualityAviationHelpdesk.Tests" />
  </ItemGroup>

</Project>
