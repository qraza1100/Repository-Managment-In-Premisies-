{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // NEVER put real connection strings here: set them in the deploy agent's Environment for this application
  // (ConnectionStrings__Helpdesk and ConnectionStrings__Legacy). They are stored encrypted on the server.
  //   Helpdesk  the helpdesk's own database, e.g. Server=...;Database=QAHelpdesk;User Id=qa_helpdesk_app;Password=...;Encrypt=True;TrustServerCertificate=True
  //   Legacy    Q+ CMR, read-only login, e.g. Server=...;Database=TraacsSupportDB;User Id=qa_helpdesk_legacy;Password=...;ApplicationIntent=ReadOnly;Encrypt=True;TrustServerCertificate=True
  "ConnectionStrings": {
    "Helpdesk": "",
    "Legacy": ""
  },

  "Database": {
    // Apply db\migrations\*.sql at start-up. Set false when a DBA runs them and the login has no DDL rights.
    "AutoMigrate": true
  },

  "Portal": {
    // Q+ CMR roles that see the management dashboard (read-only)
    "ExecutiveRoles": [ "Administrator", "Admin", "Corporate Admin", "Corporate Supervisor", "Corporate Ticketing Supervisor", "Aeroglobe Supervisor", "User Activity Viewer", "Git User" ],
    // Individual Q+ CMR user names or e-mail addresses that also see it
    "ExecutiveUsers": [],
    // Q+ CMR roles that may raise tickets; empty = every active Q+ CMR user
    "RequesterRoles": [],
    // A signed-in person is looked up again in Q+ CMR this often (seconds)
    "RecheckSeconds": 60,
    "SessionHours": 10,
    "MaxSessionHours": 12
  },

  "GatePass": {
    // The deploy agent on this same server. It checks the IT client's logins with the repository API's keys.
    "AgentUrl": "https://127.0.0.1:5003",
    // The server certificate's SHA-256 thumbprint: the same value as ApiSettings:CertificateThumbprint in the client
    "AgentThumbprint": "52FAE0908146289B7C8758700DDA81E7D05CD2989E36DDD2D870A29FC7F6B301",
    // Client logins that are IT leads besides the deploy agent's administrators (they edit form fields and settings)
    "ItLeads": [],
    "CacheSeconds": 60
  }
}
