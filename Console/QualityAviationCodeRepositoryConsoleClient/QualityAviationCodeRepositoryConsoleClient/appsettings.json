{
  "ApiSettings": {
    // IDENTIFICATION OF THE SERVER. This is the one setting the client needs.
    // SHA-256 thumbprint of the server certificate: the API prints it at startup, or run "<api exe> cert" on the host.
    // The client goes through the whole network and only accepts the machine that proves it owns this certificate.
    // It changes only if the server's DataPath\server.pfx is replaced.
    "CertificateThumbprint": "52FAE0908146289B7C8758700DDA81E7D05CD2989E36DDD2D870A29FC7F6B301",

    // The HTTPS port the server listens on (the port in "Urls" on the server).
    "ServerPort": 5001,

    // HTTPS port of the deploy agent on the same server: the Deployments control panel and changed-files sync.
    // Without the agent the client still works and sends whole folders.
    "AgentPort": 5003,

    // UDP port of the server's search service, a faster way to find it when the server offers it. 0 = do not use.
    "DiscoveryPort": 5002,

    // The client always goes through the networks this PC is connected to. If the server lives in ANOTHER network,
    // name that network here and it is gone through as well, e.g. [ "10.0.1.0/24" ]. Private ranges only, up to /20 each.
    "SearchNetworks": [ "10.0.50.0/24", "10.0.248.0/22" ],

    // Normally empty: the server is found by searching, not by a list of addresses.
    // Only for a server on a network this PC cannot search, e.g. [ "https://172.20.5.10:5001/" ].
    "BaseUrls": [],

    "TimeoutSeconds": 30,
    "TransferStallSeconds": 60,
    "MaxRetries": 4
  },

  "Helpdesk": {
    // The Q+ Helpdesk web application, as registered in Deployments. The client finds its port from the deploy agent.
    "AppName": "helpdesk",
    // Normally 0 (found automatically). Only to name the port by hand.
    "Port": 0
  },

  "Update": {
    // AUTOMATIC CLIENT UPDATES. The repository that holds the published client: dist\client pushed as it is.
    // After every sign-in the client installs the newest version from it and restarts. Empty = no automatic updates.
    "Repository": "qaim/qa-client",

    // Anyone may push to any repository, so only versions pushed by these logins are installed.
    // Empty = the repository's owner only.
    "Publishers": []
  }
}
